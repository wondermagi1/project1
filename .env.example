# 首次配置时复制为项目根目录下的 .env；已有 .env 时直接编辑，也可设置环境变量。
# 未设置 CODE_AGENT_API_KEY 时，程序会自动使用内置离线规则引擎（--provider mock 的效果）。

# API Key（也支持 OPENAI_API_KEY）
CODE_AGENT_API_KEY=

# OpenAI 兼容接口地址
CODE_AGENT_BASE_URL=https://api.openai.com/v1

# 模型名
CODE_AGENT_MODEL=gpt-4o-mini

# auto / openai / mock
CODE_AGENT_PROVIDER=auto
